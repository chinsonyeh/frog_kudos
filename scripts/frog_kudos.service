[Unit]
Description=Frog Kudos Family Reward System
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=chinsonyeh
Group=chinsonyeh
WorkingDirectory=/home/chinsonyeh/frog_kudos
ExecStart=/home/chinsonyeh/frog_kudos/run.sh
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
